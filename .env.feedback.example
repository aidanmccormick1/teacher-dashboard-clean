# Server only. Merge these names into the API deployment's environment.
RESEND_API_KEY=
FEEDBACK_NOTIFICATION_EMAIL=am@aidanmccormick.com
FEEDBACK_EMAIL_FROM=
APP_PUBLIC_URL=
FEEDBACK_EMAIL_ENABLED=true
FEEDBACK_INBOX_PASSWORD=
FEEDBACK_RETENTION_DAYS=90

# Dedicated PRIVATE bucket. Required for screenshots; text feedback works without it.
FEEDBACK_S3_BUCKET=
# Reuse existing S3 configuration. Never expose these through VITE_ variables.
S3_REGION=auto
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Public build metadata. Vite also detects the deployment commit when available.
VITE_APP_VERSION=
VITE_COMMIT_SHA=
VITE_DEPLOYMENT_ID=
